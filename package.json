{
  "name": "qr-menu-saas",
  "version": "1.0.0",
  "private": true,
  "description": "QR Menu SaaS Platform for Restaurants",
  "workspaces": [
    "api",
    "frontend/dashboard",
    "frontend/public-menu",
    "libs/shared-types"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:dashboard\" \"npm run dev:public\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:dashboard": "npm run dev --workspace=frontend/dashboard",
    "dev:public": "npm run dev --workspace=frontend/public-menu",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
