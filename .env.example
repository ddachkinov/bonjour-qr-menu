# Application
NODE_ENV=development
APP_BASE_DOMAIN=localhost:3000
API_PORT=3001
API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/qrmenu_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_TTL_SECONDS=3600

# AWS S3 (or compatible)
S3_BUCKET=qrmenu-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# CDN
CDN_BASE_URL=https://cdn.yourdomain.com

# Email
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Queue
QUEUE_URL=amqp://localhost:5672

# Security
ORDER_TOKEN_SECRET=your-order-token-secret
WEBHOOK_SECRET=your-webhook-secret
RATE_LIMIT_PER_MINUTE=60

# Stripe (for billing)
STRIPE_API_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Monitoring
SENTRY_DSN=

# ACME / Let's Encrypt
ACME_ACCOUNT_EMAIL=admin@yourdomain.com

# Feature Flags
ENABLE_CUSTOM_DOMAINS=false
ENABLE_WEBHOOKS=false
